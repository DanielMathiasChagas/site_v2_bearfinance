# Bear Finance — variáveis de ambiente do server.js
# Copie para .env e suba com: node --env-file=.env server.js   (Node >= 20.6)
# Nunca versione um .env com credenciais reais. Todas as variáveis são opcionais:
# sem nenhuma delas o site funciona e os leads ficam só em data/<form>.jsonl.

# Porta HTTP (padrão 3000)
PORT=3000

# Atrás de proxy reverso/CDN (nginx, Cloudflare, Render, Railway…): número de proxies confiáveis
# para ler o IP real em X-Forwarded-For (usado no rate limit). Vazio = automático: confia no cabeçalho
# só quando a conexão chega de rede privada/loopback. 0 = nunca confiar.
TRUST_PROXY=

# 1 = envia Strict-Transport-Security sempre (só com HTTPS já funcionando em produção).
# Sem isso, o cabeçalho é enviado apenas quando o proxy manda X-Forwarded-Proto: https.
FORCE_HSTS=

# Encaminha cada lead (JSON) por POST para um CRM, n8n, Zapier, Make… (opcional)
LEADS_WEBHOOK_URL=

# E-mail por SMTP: só ativa quando TODAS as seis variáveis abaixo estão definidas.
# Exemplos de porta: 587 (STARTTLS, padrão) ou 465 (TLS implícito).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Quem recebe os leads (separe vários por vírgula) e o remetente autorizado pelo provedor
LEADS_TO=
LEADS_FROM=
# Opcionais: SMTP_SECURE=1 força TLS implícito (padrão: automático quando a porta é 465);
# SMTP_STARTTLS=0 desliga a exigência de STARTTLS (apenas para um relay na própria máquina).
SMTP_SECURE=
SMTP_STARTTLS=
